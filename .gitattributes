# .gitattributes — enforce LF everywhere; production fix for CRLF in shell scripts
# See: https://git-scm.com/docs/gitattributes

# Default: normalize to LF on commit, checkout as LF
* text=auto eol=lf

# Shell scripts — must be LF (WSL bash fails on CRLF)
*.sh text eol=lf
*.bash text eol=lf

# Git hooks — must be LF
.githooks/* text eol=lf

# PowerShell — keep LF as well (pwsh handles both, LF is canonical)
*.ps1 text eol=lf

# SQL / Python / YAML / Make
*.sql text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf
*.mk text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf

# Windows batch — keep CRLF if you ever add .bat/.cmd (not in this repo)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.jar binary
*.parquet binary
*.gz binary
*.zip binary

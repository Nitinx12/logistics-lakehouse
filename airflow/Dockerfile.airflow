# Airflow scheduler and worker image with locked project deps and Java for Spark.
FROM apache/airflow:2.11.2-python3.12 AS builder
COPY --from=ghcr.io/astral-sh/uv:0.11.18 /uv /bin/uv
WORKDIR /opt/build
COPY --chown=airflow:root pyproject.toml uv.lock README.md .python-version ./
RUN /bin/uv sync --frozen --no-dev --python 3.12

FROM apache/airflow:2.11.2-python3.12
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists \
    && mkdir -p /app \
    && chown -R airflow:root /app
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
USER airflow
COPY --from=ghcr.io/astral-sh/uv:0.11.18 /uv /bin/uv
COPY --chown=airflow:root --from=builder /opt/build/.venv /app/.venv
COPY --chown=airflow:root pyproject.toml uv.lock README.md .python-version /app/
COPY --chown=airflow:root src /app/src
COPY --chown=airflow:root scripts /app/scripts
COPY --chown=airflow:root contracts /app/contracts
COPY --chown=airflow:root jars /app/jars
COPY --chown=airflow:root gx /app/gx
COPY --chown=airflow:root sql /app/sql
COPY --chown=airflow:root airflow /app/airflow
WORKDIR /app

# Airflow scheduler and worker image with locked project deps and Java for Spark.
FROM apache/airflow:2.11.2-python3.12 AS builder
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python
COPY --from=ghcr.io/astral-sh/uv:0.11.18 /uv /bin/uv
WORKDIR /opt/build
COPY --chown=airflow:root pyproject.toml uv.lock README.md .python-version ./
RUN /bin/uv sync --frozen --no-dev

FROM apache/airflow:2.11.2-python3.12
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python
USER airflow
COPY --from=ghcr.io/astral-sh/uv:0.11.18 /uv /bin/uv
COPY --chown=airflow:root --from=builder /opt/uv-python /opt/uv-python
COPY --chown=airflow:root --from=builder /opt/build/.venv /app/.venv
COPY --chown=airflow:root pyproject.toml uv.lock README.md .python-version /app/
COPY --chown=airflow:root src scripts contracts jars gx sql airflow /app/
WORKDIR /app

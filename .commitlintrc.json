{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      ["feat", "fix", "docs", "chore", "refactor", "test", "ci", "build", "perf", "style", "revert"]
    ],
    "header-max-length": [2, "always", 72],
    "subject-case": [0],
    "body-max-line-length": [0]
  }
}
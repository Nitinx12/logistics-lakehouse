# =============================================================================
# lakehouse - environment template
# Copy to .env and fill in real values:   cp .env.example .env
# NEVER commit .env. Only this template is tracked in git.
# Generate secrets with:  openssl rand -hex 32
# (Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# (Kafka cluster ID: any UUID, e.g. python -c "import uuid; print(uuid.uuid4())")
# (Gmail: Google Account -> Security -> 2-Step Verification -> App passwords;
#  use the 16-character APP PASSWORD, never your normal Gmail password.)
# =============================================================================

#-----------------------------------------
# Environment Variables
#-----------------------------------------
ENVIRONMENT=local
BUSINESS_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
LOG_DIR=logs


#-----------------------------------------
# MongoDB Database Configuration
#-----------------------------------------
MongoDB_URI=mongodb://localhost:27017/fleet_operations
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=fleet_operations

#-----------------------------------------
# Databricks Configuration
#-----------------------------------------
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi_change_me
DATABRICKS_CATALOG=logistics_operations
DATABRICKS_PATH=/sql/1.0/warehouses/<warehouse_id>
DATABRICKS_SCHEMA=default

#-----------------------------------------
# PostgreSQL Database Configuration
#-----------------------------------------
# Least-privilege roles (created by migrations)
PG_ETL_USER=etl_writer
PG_ETL_PASSWORD=change_me
PG_DQ_USER=dq_runner
PG_DQ_PASSWORD=change_me
PG_ANALYST_USER=analyst_ro
PG_ANALYST_PASSWORD=change_me
PG_DASHBOARD_USER=dashboard_ro
PG_DASHBOARD_PASSWORD=change_me

# PgBouncer (apps connect here, not directly to Postgres)
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_MAX_CLIENT_CONN=200

# Backups (pgBackRest / WAL-G)
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=14
BACKUP_TARGET_PATH=/backups

#-----------------------------------------
# PySpark extraction
#-----------------------------------------
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_SQL_SHUFFLE_PARTITIONS=16
SPARK_JDBC_BATCHSIZE=10000
SPARK_NUM_PARTITIONS=8             # parallel partitioned reads
SPARK_LOG_LEVEL=ERROR              # keeps py4j / Spark noise out of the console

# Incremental processing
WATERMARK_COLUMN=loaded_at
WATERMARK_OVERLAP_MINUTES=60       # re-read window to catch late-arriving rows
EXTRACT_CHUNK_HOURS=6              # time-window size per chunk
BRONZE_RETENTION_DAYS=14

#-----------------------------------------
# Airflow metadata DB (separate from the warehouse)
#-----------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_DB_NAME=airflow

# =====================================
# Airflow core (full AIRFLOW__ names pass straight into containers)
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =====================================
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__FERNET_KEY=change_me_generate_with_cryptography_fernet
AIRFLOW__WEBSERVER__SECRET_KEY=change_me
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:change_me@airflow-metadata:5432/airflow

# Admin user (official compose names)
_AIRFLOW_WWW_USER_CREATE=true
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_me

# =====================================
# Mail Alert Configuration
# =====================================
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=you@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=your_16_char_app_password
AIRFLOW__SMTP__SMTP_MAIL_FROM=you@gmail.com

# -----------------------------------------------------------------------------
# Kafka (KRaft mode)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLUSTER_ID=change_me_generate_with_kafka_storage_random_uuid
KAFKA_REPLICATION_FACTOR=1         # 3 in prod
KAFKA_MIN_INSYNC_REPLICAS=1        # 2 in prod
KAFKA_SECURITY_PROTOCOL=PLAINTEXT  # SASL_SSL in prod
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

KAFKA_TOPIC_DELIVERY_EVENTS=lh.delivery_events.v1
KAFKA_TOPIC_DELIVERY_EVENTS_DLQ=lh.delivery_events.v1.dlq
KAFKA_TOPIC_TRIP_STATUS=lh.trip_status.v1
KAFKA_TOPIC_DELIVERY_ALERTS=lh.delivery_alerts.v1
KAFKA_PARTITIONS_DELIVERY_EVENTS=6
KAFKA_RETENTION_MS_DELIVERY_EVENTS=604800000      # 7 days
KAFKA_RETENTION_MS_DLQ=2592000000                 # 30 days

# Producer
PRODUCER_ACKS=all
PRODUCER_ENABLE_IDEMPOTENCE=true
PRODUCER_COMPRESSION=zstd
PRODUCER_LINGER_MS=30
REPLAY_SPEED_FACTOR=100            # simulated live traffic multiplier
REPLAY_START_DATE=
REPLAY_END_DATE=

# Consumers
CONSUMER_GROUP_PG_SINK=lh-pg-sink
CONSUMER_GROUP_REDIS_SINK=lh-redis-sink
CONSUMER_GROUP_ALERTS=lh-alerts
CONSUMER_AUTO_OFFSET_RESET=earliest

# -----------------------------------------------------------------------------
# Flink
# -----------------------------------------------------------------------------
FLINK_JOBMANAGER_HOST=flink-jobmanager
FLINK_JOBMANAGER_RPC_PORT=6123
FLINK_UI_PORT=8081
FLINK_PARALLELISM=6                # match topic partition count
FLINK_STATE_BACKEND=rocksdb
FLINK_CHECKPOINT_INTERVAL_MS=60000
FLINK_CHECKPOINT_DIR=file:///flink/checkpoints
FLINK_WATERMARK_OUT_OF_ORDER_SECONDS=30
FLINK_ALLOWED_LATENESS_SECONDS=120
FLINK_STUCK_TRIP_MINUTES=30

# -----------------------------------------------------------------------------
# Redis
# Two separate instances: never share cache and Celery broker.
# -----------------------------------------------------------------------------
REDIS_BROKER_HOST=redis-broker
REDIS_BROKER_PORT=6379
REDIS_BROKER_PASSWORD=change_me

REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=change_me
REDIS_CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Data quality
# -----------------------------------------------------------------------------
DQ_FAIL_ON_CRITICAL=true
DQ_QUARANTINE_ENABLED=true
DQ_VOLUME_ANOMALY_BAND_PCT=30
GX_DATA_DOCS_DIR=/opt/gx/data_docs

# -----------------------------------------------------------------------------
# SLO / freshness thresholds
# -----------------------------------------------------------------------------
SLO_FRESHNESS_HOURS=24
SLO_BATCH_DURATION_P95_MIN=30
SLO_STREAM_LAG_SECONDS=60
SLO_STREAM_BATCH_DRIFT_PCT=0.5
SLO_RUN_SUCCESS_TARGET_PCT=99

# -----------------------------------------------------------------------------
# Streamlit dashboard
# -----------------------------------------------------------------------------
STREAMLIT_PORT=8501
STREAMLIT_PG_HOST=pgbouncer
STREAMLIT_PG_PORT=6432
STREAMLIT_PG_USER=dashboard_ro
STREAMLIT_PG_PASSWORD=change_me
STREAMLIT_CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
POSTGRES_EXPORTER_PORT=9187
KAFKA_EXPORTER_PORT=9308
REDIS_EXPORTER_PORT=9121

# Alertmanager sends through the same Gmail SMTP settings above
ALERTMANAGER_SMTP_SMARTHOST=smtp.gmail.com:587
ALERTMANAGER_SMTP_FROM=you@gmail.com
ALERTMANAGER_SMTP_AUTH_USERNAME=you@gmail.com
ALERTMANAGER_SMTP_AUTH_PASSWORD=your_16_char_app_password
ALERTMANAGER_RECEIVER_EMAIL=you@gmail.com

# -----------------------------------------------------------------------------
# Report (LaTeX)
# -----------------------------------------------------------------------------
REPORT_OUTPUT_DIR=/opt/report/out
REPORT_TITLE=Lakehouse Logistics Report
REPORT_EMAIL_ON_PUBLISH=false      # attach PDF and email via Gmail SMTP when true
